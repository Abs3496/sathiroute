# Local Compose configuration only. Replace every placeholder before use.
ROUTEMESH_DB_PASSWORD=replace-with-a-local-database-password
ROUTEMESH_REDIS_PASSWORD=replace-with-a-local-redis-password
ROUTEMESH_OTP_KEY=replace-with-at-least-32-random-bytes-base64-encoded
ROUTEMESH_DISPATCHER_SUBJECTS=dispatch@example.test
ROUTEMESH_ADMIN_SUBJECTS=
ROUTEMESH_OPERATIONS_MANAGER_SUBJECTS=
ROUTEMESH_SERVICE_PARTNER_SUBJECTS=
ROUTEMESH_TWILIO_ACCOUNT_SID=
ROUTEMESH_TWILIO_AUTH_TOKEN=
ROUTEMESH_TWILIO_FROM_NUMBER=
ROUTEMESH_API_REQUESTS_PER_MINUTE=300
ROUTEMESH_SERVICE_COMPLETION_OTP_REQUIRED=false
ROUTEMESH_DEMO_AUTH_ENABLED=true
